# 이 파일을 복사해서 .streamlit/secrets.toml 로 저장한 뒤 실제 값으로 채워주세요.
# secrets.toml 파일은 절대 git 등에 커밋하지 마세요 (.gitignore에 추가 권장).

[kis]
APP_KEY = "발급받은 APP KEY를 입력하세요"
APP_SECRET = "발급받은 APP SECRET을 입력하세요"
CANO = "계좌번호 앞 8자리"
ACNT_PRDT_CD = "계좌상품코드 (보통 01)"
IS_VIRTUAL = true   # 모의투자 계좌면 true, 실전투자 계좌면 false

# 텔레그램 알림 (선택 사항 - 설정하지 않으면 알림 기능만 비활성화되고 나머지는 정상 동작)
# 1) @BotFather 에게 /newbot 으로 봇을 만들고 BOT_TOKEN을 발급받으세요.
# 2) 만든 봇과 대화를 시작한 뒤(아무 메시지나 전송), 아래 주소로 CHAT_ID를 확인하세요.
#    https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
[telegram]
BOT_TOKEN = "발급받은 텔레그램 봇 토큰을 입력하세요"
CHAT_ID = "알림을 받을 chat_id를 입력하세요"
